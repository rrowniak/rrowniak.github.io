source "https://rubygems.org"

# Match the exact gem set GitHub Pages builds with, so local previews and the
# live site stay in sync (GitHub Pages currently builds with Jekyll 3.9.x).
gem "github-pages", group: :jekyll_plugins

# Required by `jekyll serve` on Ruby 3+, where WEBrick is no longer bundled.
gem "webrick", "~> 1.8"
